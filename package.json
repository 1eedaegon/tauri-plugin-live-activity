{
  "name": "tauri-plugin-live-activity",
  "version": "0.6.0",
  "description": "Tauri 2 plugin for iOS Live Activities (ActivityKit and Dynamic Island) and Android Live Updates with ongoing notification fallback",
  "author": "1eedaegon",
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1eedaegon/tauri-plugin-live-activity.git"
  },
  "homepage": "https://github.com/1eedaegon/tauri-plugin-live-activity#readme",
  "bugs": "https://github.com/1eedaegon/tauri-plugin-live-activity/issues",
  "keywords": ["tauri", "tauri-plugin", "tauri-v2", "ios", "ipados", "android", "live-activity", "live-activities", "activitykit", "dynamic-island", "live-updates", "notifications"],
  "sideEffects": false,
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.js",
  "exports": {
    ".": { "types": "./dist-js/index.d.ts", "import": "./dist-js/index.js" },
    "./jsx": { "types": "./dist-js/jsx/index.d.ts", "import": "./dist-js/jsx/index.js" },
    "./jsx/jsx-runtime": { "types": "./dist-js/jsx/jsx-runtime.d.ts", "import": "./dist-js/jsx/jsx-runtime.js" },
    "./jsx/jsx-dev-runtime": { "types": "./dist-js/jsx/jsx-dev-runtime.d.ts", "import": "./dist-js/jsx/jsx-dev-runtime.js" },
    "./react": { "types": "./dist-js/react/index.d.ts", "import": "./dist-js/react/index.js" },
    "./package.json": "./package.json"
  },
  "bin": { "tauri-plugin-live-activity": "cli/bin.mjs" },
  "files": ["dist-js", "cli", "README.md", "README.ko.md", "LICENSE", "LICENSE-APACHE", "LICENSE-MIT"],
  "publishConfig": { "access": "public", "tag": "next" },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/demo/tsconfig.json",
    "test": "npm run build && npm run test:contracts && npm run test:api && npm run test:jsx && npm run test:react && npm run test:demo && npm run test:setup",
    "test:contracts": "node --test --experimental-test-coverage \"--test-coverage-include=tools/validate-request.mjs\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/requests.test.mjs tests/layout-requests.test.mjs tests/contract-sync.test.mjs tests/android-liveupdate.test.mjs tests/ci.test.mjs tests/ci-cache.test.mjs tests/spec-coverage.test.mjs",
    "test:api": "node --test --experimental-test-coverage \"--test-coverage-include=dist-js/*.js\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/api.test.mjs",
    "test:jsx": "node --experimental-strip-types --test --experimental-test-coverage \"--test-coverage-include=dist-js/jsx/*.js\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/jsx.test.mjs",
    "test:react": "node --test --experimental-test-coverage \"--test-coverage-include=dist-js/react/*.js\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/react.test.mjs",
    "test:demo": "node --experimental-strip-types --test --experimental-test-coverage \"--test-coverage-include=examples/demo/src/*.ts\" \"--test-coverage-exclude=examples/demo/tests/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 examples/demo/tests/self-test.test.mjs examples/demo/tests/ui-state.test.mjs examples/demo/tests/layouts.test.mjs examples/demo/tests/setup.test.mjs",
    "test:setup": "node --test --experimental-test-coverage \"--test-coverage-include=cli/*.mjs\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/setup.test.mjs",
    "build:demo": "npm run build && node examples/demo/build.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/api": "2.12.4",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-test-renderer": "19.3.1",
    "typescript": "7.0.2"
  }
}
