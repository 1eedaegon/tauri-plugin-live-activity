<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <application>
        <!-- liveupdate's receivers, from its Android adapter (tools/sync-liveupdate.mjs). -->
        <receiver android:name="io.github.eedaegon.liveupdate.LiveUpdateActionReceiver" android:exported="false" />
        <receiver android:name="io.github.eedaegon.liveupdate.LiveUpdateDismissReceiver" android:exported="false" />
        <!-- Watches the app's activities from the start of the process, for the intents of liveupdate's notifications
             that open the app (Openings.kt). It holds no data. -->
        <provider
            android:name="io.github.eedaegon.liveactivity.OpeningsProvider"
            android:authorities="${applicationId}.live-activity-openings"
            android:exported="false" />
    </application>
</manifest>
