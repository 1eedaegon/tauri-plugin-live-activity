<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Live Activity native tests">
        <activity android:name="io.github.eedaegon.liveactivity.TestHostActivity" android:exported="true">
            <!-- The scheme of the URLs that the contents of tests/fixtures/android/contents.json open: liveupdate
                 refuses to post a URL that no activity of the app opens. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mochi" />
            </intent-filter>
        </activity>
        <!-- An activity as Tauri's is one: AndroidX tells its listeners of each new intent. -->
        <activity android:name="io.github.eedaegon.liveactivity.OpeningsHostActivity" android:exported="false" />
    </application>
</manifest>
